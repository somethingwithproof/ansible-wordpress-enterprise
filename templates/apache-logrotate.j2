# Logrotate for WordPress Apache logs
# Generated by Ansible - Do not edit manually

{{ wordpress_log_dir }}/apache/*.log {
    {{ wordpress_logrotate_frequency }}
    rotate {{ wordpress_logrotate_retention }}
    missingok
    notifempty
    compress
    delaycompress
    sharedscripts
    postrotate
        if [ -x /usr/sbin/apachectl ]; then
            /usr/sbin/apachectl graceful > /dev/null 2>&1 || true
        else
            /usr/sbin/httpd -k graceful > /dev/null 2>&1 || true
        fi
    endscript
}
