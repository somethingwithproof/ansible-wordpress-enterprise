# Apache to PHP-FPM handoff for WordPress
# Generated by Ansible - Do not edit manually

<IfModule proxy_fcgi_module>
    # Only proxy files that exist, so a missing .php returns 404 rather than
    # reaching the pool and logging a "Primary script unknown" error.
    <FilesMatch \.php$>
        SetHandler "proxy:unix:{{ wordpress_php_fpm_listen }}|fcgi://localhost"
    </FilesMatch>

    <Proxy "fcgi://localhost">
        ProxySet timeout={{ wordpress_php_max_execution_time | default(300) }}
    </Proxy>
</IfModule>
