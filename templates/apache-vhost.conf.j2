# Apache virtual host for WordPress
# Generated by Ansible - Do not edit manually

{% if wordpress_enable_logging %}
{%   set log_dir = wordpress_log_dir ~ '/apache' %}
{% elif ansible_os_family == 'Debian' %}
{%   set log_dir = '${APACHE_LOG_DIR}' %}
{% else %}
{%   set log_dir = 'logs' %}
{% endif %}

<VirtualHost *:{{ wordpress_http_port }}>
    ServerName {{ wordpress_server_name }}
    ServerAdmin {{ wordpress_admin_email }}
    DocumentRoot {{ wordpress_install_dir }}

{% if wordpress_enable_ssl %}
    # Everything except the ACME challenge moves to HTTPS.
    RewriteEngine On
    RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/
    RewriteRule ^(.*)$ https://{{ wordpress_server_name }}$1 [R=301,L]
{% endif %}

    <Directory {{ wordpress_install_dir }}>
        Options -Indexes +FollowSymLinks
        AllowOverride All
        Require all granted
    </Directory>

    ErrorLog {{ log_dir }}/error.log
    CustomLog {{ log_dir }}/access.log combined
</VirtualHost>

{% if wordpress_enable_ssl %}
<IfModule mod_ssl.c>
<VirtualHost *:{{ wordpress_https_port }}>
    ServerName {{ wordpress_server_name }}
    ServerAdmin {{ wordpress_admin_email }}
    DocumentRoot {{ wordpress_install_dir }}

    SSLEngine on
    SSLCertificateFile {{ wordpress_ssl_certificate }}
    SSLCertificateKeyFile {{ wordpress_ssl_certificate_key }}

    <Directory {{ wordpress_install_dir }}>
        Options -Indexes +FollowSymLinks
        AllowOverride All
        Require all granted
    </Directory>

    ErrorLog {{ log_dir }}/ssl-error.log
    CustomLog {{ log_dir }}/ssl-access.log combined
</VirtualHost>
</IfModule>
{% endif %}
