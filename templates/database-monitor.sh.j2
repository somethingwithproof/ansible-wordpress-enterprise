#!/bin/bash
# WordPress database monitoring
# Generated by Ansible - Do not edit manually
set -euo pipefail

LOG_FILE="{{ wordpress_log_dir }}/database-monitor.log"

log() {
    printf '%s %s\n' "$(date --iso-8601=seconds)" "$1" >> "$LOG_FILE"
}

# Credentials come from /root/.my.cnf so they stay out of the process list.
if ! mysqladmin ping --silent 2>/dev/null; then
    log "CRITICAL database is not responding"
    exit 2
fi

threads=$(mysqladmin status 2>/dev/null | grep -oE 'Threads: [0-9]+' | awk '{print $2}' || true)
slow=$(mysql -N -B -e "SHOW GLOBAL STATUS LIKE 'Slow_queries'" 2>/dev/null | awk '{print $2}' || true)
size=$(mysql -N -B -e "SELECT ROUND(SUM(data_length + index_length) / 1024 / 1024, 1) \
    FROM information_schema.tables WHERE table_schema = '{{ wordpress_db_name }}'" 2>/dev/null || true)

log "OK threads=${threads:-unknown} slow_queries=${slow:-unknown} size_mb=${size:-unknown}"
