# Apache main configuration for WordPress (RHEL/Rocky)
# Generated by Ansible - Do not edit manually
#
# Mirrors the stock httpd layout. conf.modules.d is what loads modules, so
# that Include must not be dropped.

ServerRoot "{{ wordpress_apache_conf_path }}"
Listen {{ wordpress_http_port }}

Include conf.modules.d/*.conf

User {{ wordpress_system_user }}
Group {{ wordpress_system_group }}

ServerAdmin {{ wordpress_admin_email }}
ServerName {{ wordpress_server_name }}

Timeout {{ wordpress_apache_timeout | default(300) }}
KeepAlive On
MaxKeepAliveRequests {{ wordpress_apache_max_keepalive_requests | default(100) }}
KeepAliveTimeout {{ wordpress_apache_keepalive_timeout | default(5) }}

<Directory />
    AllowOverride none
    Require all denied
</Directory>

DocumentRoot "{{ wordpress_install_dir }}"

<Directory "{{ wordpress_install_dir }}">
    Options -Indexes +FollowSymLinks
    AllowOverride All
    Require all granted
</Directory>

<IfModule dir_module>
    DirectoryIndex index.php index.html
</IfModule>

<Files ".ht*">
    Require all denied
</Files>

ErrorLog "logs/error_log"
LogLevel {{ wordpress_apache_log_level | default('warn') }}

<IfModule log_config_module>
    LogFormat "%h %l %u %t \"%r\" %>s %b \"%{Referer}i\" \"%{User-Agent}i\"" combined
    LogFormat "%h %l %u %t \"%r\" %>s %b" common
    CustomLog "logs/access_log" combined
</IfModule>

<IfModule mime_module>
    # RHEL ships mime.types in the mailcap package at /etc/mime.types, not
    # under ServerRoot as upstream Apache does.
    TypesConfig /etc/mime.types
    AddType application/x-compress .Z
    AddType application/x-gzip .gz .tgz
</IfModule>

AddDefaultCharset UTF-8

EnableSendfile on

IncludeOptional conf.d/*.conf
