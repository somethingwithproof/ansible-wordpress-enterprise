# Nginx FastCGI cache for WordPress
# Generated by Ansible - Do not edit manually
#
# The WORDPRESS zone is declared here and referenced by the site config; both
# are gated on wordpress_enable_nginx_cache so a reference cannot outlive its
# declaration.

fastcgi_cache_path /var/cache/nginx/wordpress
                   levels=1:2
                   keys_zone=WORDPRESS:{{ wordpress_nginx_cache_zone_size | default('100m') }}
                   inactive={{ wordpress_nginx_cache_inactive | default('60m') }}
                   max_size={{ wordpress_nginx_cache_max_size | default('1g') }};

fastcgi_cache_key "$scheme$request_method$host$request_uri";
fastcgi_cache_use_stale error timeout invalid_header updating http_500 http_503;
fastcgi_cache_lock on;
