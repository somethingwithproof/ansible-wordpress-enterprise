# Nginx gzip settings for WordPress
# Generated by Ansible - Do not edit manually

gzip on;
gzip_vary on;
gzip_proxied any;
gzip_comp_level {{ wordpress_nginx_gzip_level | default(6) }};
gzip_min_length 256;
gzip_disable "msie6";
gzip_types
    text/plain
    text/css
    text/xml
    text/javascript
    application/json
    application/javascript
    application/xml+rss
    application/rss+xml
    font/truetype
    font/opentype
    application/vnd.ms-fontobject
    image/svg+xml;
