# Logrotate for WordPress Nginx logs
# Generated by Ansible - Do not edit manually

{{ wordpress_log_dir }}/nginx/*.log {
    {{ wordpress_logrotate_frequency }}
    rotate {{ wordpress_logrotate_retention }}
    missingok
    notifempty
    compress
    delaycompress
    create 0640 {{ wordpress_system_user }} {{ wordpress_system_group }}
    sharedscripts
    postrotate
        [ -f /run/nginx.pid ] && kill -USR1 "$(cat /run/nginx.pid)" || true
    endscript
}
