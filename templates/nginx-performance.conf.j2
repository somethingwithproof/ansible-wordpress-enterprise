# Nginx performance settings for WordPress
# Generated by Ansible - Do not edit manually

open_file_cache max=2000 inactive=20s;
open_file_cache_valid 60s;
open_file_cache_min_uses 2;
open_file_cache_errors off;

client_body_buffer_size {{ wordpress_nginx_client_body_buffer_size | default('16k') }};
client_max_body_size {{ wordpress_nginx_client_max_body_size | default('64m') }};
client_header_buffer_size {{ wordpress_nginx_client_header_buffer_size | default('1k') }};
large_client_header_buffers {{ wordpress_nginx_large_client_header_buffers | default('4 8k') }};

output_buffers 2 32k;
postpone_output 1460;

reset_timedout_connection on;
