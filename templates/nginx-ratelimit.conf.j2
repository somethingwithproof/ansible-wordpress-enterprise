# Nginx rate limiting for WordPress
# Generated by Ansible - Do not edit manually
#
# Zones are declared here; the site config applies them to wp-login.php and
# xmlrpc.php, which are the endpoints that actually get hammered.

limit_req_zone $binary_remote_addr zone=wordpress_login:10m
               rate={{ wordpress_nginx_rate_limit | default('1r/s') }};
limit_req_zone $binary_remote_addr zone=wordpress_general:10m
               rate={{ wordpress_nginx_general_rate_limit | default('10r/s') }};
limit_conn_zone $binary_remote_addr zone=wordpress_conn:10m;

limit_req_status 429;
limit_conn_status 429;
