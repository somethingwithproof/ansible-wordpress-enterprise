# Rocky Linux 9 test target for WordPress Enterprise testing
FROM rockylinux:9

RUN dnf update -y && dnf install -y \
    bc \
    cronie \
    gnupg2 \
    initscripts \
    logrotate \
    openssh-server \
    python3 \
    python3-pip \
    rsyslog \
    sudo \
    systemd \
    wget \
    && dnf clean all && \
    systemctl set-default multi-user.target \
    && systemctl enable sshd \
    && systemctl enable rsyslog \
    && systemctl enable crond && \
    systemctl disable getty@tty1.service \
    && systemctl mask getty@tty1.service \
    && systemctl mask getty-static.service \
    && systemctl mask graphical-session.target && \
    useradd -m -s /bin/bash -G wheel testuser \
    && echo 'testuser ALL=(ALL) NOPASSWD:ALL' >> /etc/sudoers && \
    printf 'PermitRootLogin yes\nPasswordAuthentication yes\n' > /etc/ssh/sshd_config.d/99-test-auth.conf && \
    mkdir -p /var/www/html \
    && rm -f /etc/ssh/ssh_host_*

# Create systemd-compatible init script
COPY tests/fixtures/init-centos.sh /usr/local/bin/init-centos.sh
RUN chmod +x /usr/local/bin/init-centos.sh

# Web ports; test SSH is reachable only within the container network.
EXPOSE 80 443

# Use systemd as init system
CMD ["/usr/local/bin/init-centos.sh"]
